<Window x:Class="GameTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameTuner.App.ViewModels"
        Title="GameTuner · 离线性能工作台" Width="1180" Height="780" MinWidth="960" MinHeight="680"
        Style="{StaticResource {x:Type Window}}"
        Icon="/GameTuner.App;component/Assets/GameTuner.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <vm:EnumChoiceConverter x:Key="EnumChoiceConverter"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Model.SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportLogCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GAMETUNER" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="离线性能分析 / 实测驱动，不修改游戏" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● 完全离线 · 不修改游戏" Foreground="{DynamicResource LimeBrush}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProcessStatus}" Style="{StaticResource HintText}" MaxWidth="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ThemeButton" Style="{StaticResource ThemeButton}" Command="{Binding ThemeCommand}" Margin="14,0,0,0" Content="◐"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Model.SaveStatus}" Style="{StaticResource HintText}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CaptureStatus}" Style="{StaticResource HintText}" TextWrapping="Wrap" MaxWidth="360" Margin="20,0,0,0"/>
            </Grid>
        </Border>
        <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,18" MaxWidth="1400">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="测试目标" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="游戏名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="GameBox" Text="{Binding Model.Game, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Model.IsGoalEditable}"
                                     ToolTip="启动时会自动识别正在运行的游戏；也可以手动输入任意游戏名称"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="目标平均 FPS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TargetFpsBox" Text="{Binding Model.TargetFps, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Model.IsGoalEditable}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="画质档位" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="TierCombo" SelectedValue="{Binding Model.CurrentTier}" SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="Unknown" Content="未指定 / 混合设置"/>
                                        <ComboBoxItem Tag="Low" Content="低"/>
                                        <ComboBoxItem Tag="Medium" Content="中"/>
                                        <ComboBoxItem Tag="High" Content="高"/>
                                        <ComboBoxItem Tag="Ultra" Content="极高"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Model.GoalLabel}" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="采集与日志" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="ProcessButton" Content="选择游戏进程…" Style="{StaticResource GhostButton}" Command="{Binding ProcessCommand}" HorizontalContentAlignment="Left"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="CaptureButton" Content="开始新采集" Style="{StaticResource PrimaryButton}" Command="{Binding StartCaptureCommand}" Margin="0,0,6,0"/>
                                <Button x:Name="StopButton" Grid.Column="1" Content="停止并分析" Style="{StaticResource GhostButton}" Command="{Binding StopAndAnalyzeCommand}" Margin="6,0,0,0"/>
                            </Grid>
                            <Button x:Name="ImportButton" Content="导入外部日志…  Ctrl+O" Style="{StaticResource GhostButton}" Command="{Binding ImportLogCommand}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Model.LogPath}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            <Separator Margin="0,14" Background="{DynamicResource LineBrush}"/>
                            <Button x:Name="SettingsImportButton" Content="只读导入 JSON / XML / INI 设置…" Style="{StaticResource GhostButton}" Command="{Binding ImportSettingsCommand}"/>
                            <TextBlock Text="{Binding ConfigurationStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ConfigurationSource}" Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="本轮实际配置" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="硬件可自动读取，也可手动补充。保存的是记录，不应用游戏配置。" Style="{StaticResource HintText}"/>
                            <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ResolutionBox" Text="{Binding Model.Resolution, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="CPU" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CpuBox" Text="{Binding Model.Cpu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="GPU" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="GpuBox" Text="{Binding Model.Gpu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="内存" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MemoryBox" Text="{Binding Model.Memory, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="逐项画面设置" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="GraphicsSettingsBox" Text="{Binding Model.GraphicsSettings, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="90" VerticalContentAlignment="Top" TextWrapping="Wrap" IsReadOnly="{Binding GraphicsReadOnly}"/>
                            <TextBlock Text="测试场景 / 路线" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SceneBox" Text="{Binding Model.Scene, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button x:Name="FillButton" Content="取回所选轮次的配置" Style="{StaticResource GhostButton}" Command="{Binding FillCommand}" Margin="0,12,0,0"/>
                            <Button x:Name="UpdateButton" Content="更新所选轮次说明" Style="{StaticResource GhostButton}" Command="{Binding Model.UpdateDetailsCommand}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel DataContext="{Binding Model}">
                            <TextBlock Text="实测概览" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="平均 FPS" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding AverageFps}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{Binding DeltaFps}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="1% Low FPS" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding LowFps}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{Binding LowDelta}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedRound.CpuLoad, StringFormat=CPU · {0}}" Style="{StaticResource HintText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedRound.GpuLoad, StringFormat=GPU · {0}}" Style="{StaticResource HintText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="轮次对比" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Model.SessionLabel}" Style="{StaticResource HintText}"/>
                            <ListBox x:Name="RoundsList" ItemsSource="{Binding Model.Rounds}" SelectedItem="{Binding Model.SelectedRound}" MaxHeight="240" Margin="0,12,0,0">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding RoundLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Tier, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding BaselineDelta}" Style="{StaticResource HintText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="17">
                                            <Run Text="{Binding Average, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Low, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0" DataContext="{Binding Model.SelectedRound}">
                        <StackPanel>
                            <TextBlock Text="{Binding RecommendationTitle, TargetNullValue=等待首轮实测, FallbackValue=等待首轮实测}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding RecommendationReason}" Style="{StaticResource HintText}"/>
                            <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Setting, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding SuggestedValue, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource HintText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Warnings}" Foreground="{DynamicResource OrangeBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Precision}" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="保存与分享" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="SaveButton" Content="保存  Ctrl+S" Style="{StaticResource PrimaryButton}" Command="{Binding Model.SaveCommand}" Margin="0,0,5,0"/>
                                <Button x:Name="LoadButton" Grid.Column="1" Content="载入…" Style="{StaticResource GhostButton}" Command="{Binding LoadCommand}" Margin="5,0"/>
                                <Button x:Name="NewButton" Grid.Column="2" Content="新对比" Style="{StaticResource GhostButton}" Command="{Binding NewCommand}" Margin="5,0,0,0"/>
                            </Grid>
                            <Button x:Name="PreviewButton" Content="预览分享卡" Style="{StaticResource GhostButton}" Command="{Binding PreviewCommand}" Margin="0,10,0,0"/>
                            <Button x:Name="ExportButton" Content="导出 PNG 分享图…" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="0,8,0,0"/>
                            <ContentControl x:Name="SharePreview" Visibility="Collapsed" Margin="0,12,0,0">
                                <local:ShareCard xmlns:local="clr-namespace:GameTuner.App" DataContext="{Binding Model}"/>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
