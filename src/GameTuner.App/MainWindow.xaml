<Window x:Class="GameTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="FrameSmith"
        Width="1180"
        Height="790"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Height="32"
        FontFamily="{StaticResource BodyFont}"
        FontSize="{StaticResource FontSize13}"
        UseLayoutRounding="True"
        Background="{StaticResource BackdropBrush}">
    <Window.Resources>
        <DropShadowEffect x:Key="HeroGlow"
                          Color="{StaticResource LimeColor}"
                          BlurRadius="44"
                          Opacity="0.16"
                          ShadowDepth="0" />
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="112" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="9" Height="34" Background="{StaticResource LimeBrush}" CornerRadius="8"
                        Margin="0,0,12,0" Effect="{StaticResource HeroGlow}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FRAMESMITH" FontFamily="{StaticResource DisplayFont}"
                               FontSize="{StaticResource FontSize28}" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeroSubtitle}"
                               Style="{StaticResource EyebrowText}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HeroSubtitle}" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="12"
                        Padding="12,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource LimeBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding NvidiaStatus}" FontSize="{StaticResource FontSize12}"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="12" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource OrangeBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="RTX TUNING / v0.1" FontSize="{StaticResource FontSize12}"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="288" MaxWidth="336" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <TextBlock Text="01 / OBJECTIVE" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="定义这次调优的边界" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="{StaticResource FontSize20}" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="不用预设换皮。根据本机实际运行数据逐项调整；1% Low 底线为目标帧率的 90%。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16" />

                            <TextBlock Text="游戏" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding AvailableGames}"
                                      SelectedItem="{Binding SelectedGame}"
                                      IsEnabled="{Binding IsProfileSwitchAllowed}"
                                      DisplayMemberPath="DisplayName" />
                            <TextBlock Text="{Binding SelectedGame.ConfigScopeDescription}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                       TextWrapping="Wrap" Margin="0,4,0,16" />

                            <TextBlock Text="目标描述" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSetupEnabled}" />
                            <TextBlock Text="支持自然语言，如“60帧，画质优先”"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                       TextWrapping="Wrap" Margin="0,4,0,16" />
                            <Border Background="{StaticResource HintBrush}"
                                    BorderBrush="{StaticResource HintLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="每一轮你要做什么"
                                               FontSize="{StaticResource FontSize12}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource LimeBrush}" />
                                    <TextBlock Text="{Binding StepDescriptionText}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="目标帧率" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="30" Maximum="240" TickFrequency="15"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsSetupEnabled}"
                                        VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                         IsEnabled="{Binding IsSetupEnabled}"
                                         HorizontalContentAlignment="Center" />
                            </Grid>

                            <TextBlock Text="偏好" Style="{StaticResource MetricLabel}" Margin="0,16,0,8" />
                            <ComboBox ItemsSource="{Binding ModeChoices}"
                                      SelectedItem="{Binding SelectedMode}"
                                      IsEnabled="{Binding IsSetupEnabled}"
                                      DisplayMemberPath="Label" />
                            <TextBlock Text="{Binding SelectedMode.Description}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                       TextWrapping="Wrap" Margin="0,4,0,16" />

                            <StackPanel Visibility="{Binding IsCaptureDurationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="每轮采集时长（分钟）" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding CaptureMinuteChoices}"
                                          SelectedItem="{Binding CaptureMinutes}"
                                          IsEnabled="{Binding IsSetupEnabled}" />
                                <TextBlock Text="推荐 5 分钟；3 分钟较快，10/15 分钟更稳。范围 3–15 分钟。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                           TextWrapping="Wrap" Margin="0,4,0,16" />
                            </StackPanel>

                            <Border Background="{StaticResource InkBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="TARGET SEMANTICS" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="AVG ≥ " />
                                        <Run Text="{Binding TargetFps, StringFormat={}{0:0}}" Foreground="{StaticResource TextBrush}" />
                                        <Run Text="  /  1% LOW ≥ " />
                                        <Run Text="{Binding TargetFps, StringFormat={}{0:0}}" Foreground="{StaticResource TextBrush}" />
                                        <Run Text=" × 0.90" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="16">
                        <Button Content="开始三轮实测" Command="{Binding StartCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="取消当前会话" Command="{Binding CancelCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ConfigScopeStatus}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource LimeBrush}"
                                         Margin="0,0,8,0" Effect="{StaticResource HeroGlow}" />
                                <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontSize12}" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" />
                                <TextBlock Text="{Binding RoundLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSize13}" LineHeight="20"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Margin="0,12,0,16" />
                            <ProgressBar Value="{Binding RoundProgress, Mode=OneWay}" Minimum="0" Maximum="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="CURRENT BEST" Style="{StaticResource EyebrowText}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding FinalCandidateLabel}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSize16}"
                                       FontWeight="SemiBold" TextAlignment="Right" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FinalCandidateLabel}" />
                            <TextBlock Text="{Binding FinalCandidateReason}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FinalCandidateReason}"
                                       TextAlignment="Right" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <TabControl>
                        <TabItem Header="实时表现">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="平均帧率" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding AverageFps}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="实时均值" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="1% LOW" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding LowFps}" Style="{StaticResource MetricValue}"
                                                       Foreground="{StaticResource LimeBrush}" />
                                            <TextBlock Text="分段统计均值" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="GPU 负载" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding GpuUtil}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="图形利用率" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="CPU 负载" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding CpuUtil}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="处理器利用率" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ROUND LOG" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="每次单项变更都留下可追溯结果"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="{StaticResource FontSize16}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="每次单项变更都留下可追溯结果" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Bottleneck}" FontSize="{StaticResource FontSize12}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Bottleneck}" />
                                                <TextBlock Text="{Binding Vram}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontSize12}" Foreground="{StaticResource OrangeBrush}"
                                                           TextAlignment="Right" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Vram}" />
                                            </StackPanel>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Rounds}" Margin="0,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource InkBrush}"
                                                                BorderBrush="{StaticResource LineBrush}"
                                                                BorderThickness="1" CornerRadius="8"
                                                                Padding="12" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="8" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="8" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="{StaticResource FontSize12}" Foreground="{Binding Accent}" />
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="{Binding Candidate}" FontSize="{StaticResource FontSize13}"
                                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Candidate}" />
                                                                    <WrapPanel Margin="0,4,0,0">
                                                                        <TextBlock Text="{Binding Verdict}" FontSize="{StaticResource FontSize12}" Foreground="{Binding Accent}" />
                                                                        <TextBlock Text=" · " FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                                                        <TextBlock Text="{Binding Precision}" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}" />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Explanation}" FontSize="{StaticResource FontSize12}"
                                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                                <UniformGrid Grid.Row="4" Grid.ColumnSpan="3" Columns="4">
                                                                    <StackPanel Margin="0,0,8,0">
                                                                        <TextBlock Text="AVG" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding AverageFps}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize16}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AverageFps}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,0,8,0">
                                                                        <TextBlock Text="1% LOW" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding LowFps}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize16}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LowFps}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,0,8,0">
                                                                        <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding Gpu}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize16}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Gpu}" />
                                                                    </StackPanel>
                                                                    <StackPanel>
                                                                        <TextBlock Text="SCORE" Style="{StaticResource MetricLabel}" />
                                                                        <TextBlock Text="{Binding Score}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize16}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Score}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border Grid.Row="1" Height="24" VerticalAlignment="Bottom"
                                                Background="{StaticResource PanelBrush}"
                                                IsHitTestVisible="False">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0" />
                                                    <GradientStop Color="{StaticResource PanelColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                    <Border Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningLineBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,8"
                                            Visibility="{Binding IsPrecisionWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="本轮帧数据精度不足，结论可能不稳定。请确认采样正常开始。"
                                                   TextWrapping="Wrap" FontSize="{StaticResource FontSize12}" Foreground="{StaticResource OrangeBrush}" />
                                    </Border>
                                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Command="{Binding RestoreCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0">
                                            <TextBlock Text="恢复原始设置" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="128"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button Command="{Binding ApplyBestCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                                            <TextBlock Text="应用个性化建议" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="128"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button Command="{Binding SkipCommand}" Style="{StaticResource GhostButton}" Margin="0">
                                            <TextBlock Text="跳过 / 保留当前" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="128"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="系统与 AI">
                            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="SYSTEM READINESS" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="调优链路" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="{StaticResource FontSize20}" Margin="0,4,0,16" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource InkBrush}" CornerRadius="8"
                                                        Padding="12" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="NVIDIA" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding NvidiaStatus}" FontSize="{StaticResource FontSize12}" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{StaticResource InkBrush}"
                                                        CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="NVIDIA LOG" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding DataSourceStatus}" FontSize="{StaticResource FontSize12}" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="{StaticResource InkBrush}"
                                                        CornerRadius="8" Padding="12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ConfigStatus}" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Text="{Binding ConfigScopeStatus}" FontSize="{StaticResource FontSize12}"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding ConfigPath}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize12}"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RawConfigHash}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize12}"
                                                       Foreground="{StaticResource OrangeBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding DataDirectory}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSize12}"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DataDirectoryStatus}"
                                                       FontSize="{StaticResource FontSize12}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding DataSourceDetail}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                                       LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                                        <StackPanel>
                                            <TextBlock Text="OPTIONAL AI REVIEW" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="云端只做解释与候选评审"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="{StaticResource FontSize20}" Margin="0,4,0,4" />
                                            <TextBlock Text="留空模型名称时完全离线运行。密钥保存到 Windows 凭据管理器，不写入配置文件。"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}"
                                                       Margin="0,0,0,16" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="API ENDPOINT" Style="{StaticResource MetricLabel}"
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="MODEL" Style="{StaticResource MetricLabel}"
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="接口协议（chat / responses）" Style="{StaticResource MetricLabel}"
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding AiWireApi, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="chat 使用 Chat Completions API；responses 使用 Responses API" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="客户端标识（User-Agent，可留空）" Style="{StaticResource MetricLabel}"
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding AiUserAgent, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="留空不覆盖 User-Agent；AgentRouter 需要受支持的编程客户端标识" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="API KEY" Style="{StaticResource MetricLabel}"
                                                       Margin="0,12,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding AiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="留空不会覆盖已有密钥" />
                                                <Button Grid.Column="1" Content="保存 AI 设置"
                                                        Command="{Binding SaveAiCommand}"
                                                        Style="{StaticResource GhostButton}"
                                                        Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding SaveAiStatus}" FontSize="{StaticResource FontSize12}"
                                                       Foreground="{StaticResource LimeBrush}"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="NVIDIA 日志目录（默认 AppData\Local\nvlog）" Style="{StaticResource MetricLabel}" Margin="0,16,0,8" />
                                            <TextBox Text="{Binding TelemetryLogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                </Grid>
                <Border Grid.Row="4" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="三轮，不是玄学" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="{StaticResource FontSize16}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="不注入进程 · 不改存档 · 自动备份 · 可随时回滚"
                                       FontSize="{StaticResource FontSize12}" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="不注入进程 · 不改存档 · 自动备份 · 可随时回滚" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="01  建立基线" Foreground="{StaticResource LimeBrush}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSize13}" />
                                <TextBlock Text="保留设置，采集真实数据。" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}" Margin="0,4,0,0"
                                           ToolTip="保留当前设置，采集真实运行数据，不套官方预设。" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="02  相邻搜索" Foreground="{StaticResource OrangeBrush}"
                                           FontWeight="SemiBold" FontSize="{StaticResource FontSize13}" />
                                <TextBlock Text="优先 NVIDIA，再按瓶颈微调。" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}" Margin="0,4,0,0"
                                           ToolTip="优先使用 NVIDIA 能力，再按瓶颈微调图形设置。" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="03  复测与收敛" FontWeight="SemiBold" FontSize="{StaticResource FontSize13}" />
                                <TextBlock Text="比较结果，备份后应用。" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSize12}" Margin="0,4,0,0"
                                           ToolTip="复测并比较；最终应用自动备份、可随时回滚。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
