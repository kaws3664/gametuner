<Window x:Class="GameTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameTuner.App.ViewModels"
        xmlns:local="clr-namespace:GameTuner.App"
        Title="FrameSmith · 离线日志分析" Width="1280" Height="900" MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackdropBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TextBrush}"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <vm:EnumChoiceConverter x:Key="EnumChoice" />
        <Style x:Key="ChoiceButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource LimeBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource LimeBrush}" Margin="0,0,12,0">
                    <Path Data="M 10,30 L 10,11 L 29,11 M 10,21 L 24,21 M 18,30 L 30,30 L 30,21"
                          Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>
                <StackPanel>
                    <TextBlock Text="FrameSmith" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="看懂变化，留住你的理想画质。" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="13,9" VerticalAlignment="Center">
                <TextBlock Text="●  完全离线  /  只读日志" Foreground="{StaticResource LimeBrush}" FontSize="11" />
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="302" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <TextBlock Text="01 / YOUR GOAL" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="你的目标与配置" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,18" />
                            <TextBlock Text="游戏名称 · 不限游戏" Style="{StaticResource MetricLabel}" Margin="0,0,0,7" />
                            <TextBox x:Name="GameInput" AutomationProperties.Name="游戏名称"
                                     Text="{Binding Game, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsGoalEditable}" MaxLength="90" />
                            <WrapPanel IsEnabled="{Binding IsGoalEditable}" Margin="0,8,0,7">
                                <Button x:Name="GenericGameButton" Content="任意游戏" Tag="我的游戏" Click="OnGameChoice" Style="{StaticResource SmallButton}" />
                                <Button Content="007" Tag="007 First Light" Click="OnGameChoice" Style="{StaticResource SmallButton}" />
                                <Button Content="荒野大镖客 2" Tag="Red Dead Redemption 2" Click="OnGameChoice" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                            <TextBlock Text="目标平均帧率" Style="{StaticResource MetricLabel}" Margin="0,5,0,7" />
                            <Grid IsEnabled="{Binding IsGoalEditable}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                                <Slider x:Name="TargetSlider" Minimum="30" Maximum="240" TickFrequency="15" IsSnapToTickEnabled="True"
                                        Value="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox x:Name="TargetInput" Grid.Column="1" AutomationProperties.Name="目标帧率" HorizontalContentAlignment="Center"
                                         Text="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" />
                            </Grid>
                            <WrapPanel IsEnabled="{Binding IsGoalEditable}" Margin="0,8,0,2">
                                <Button Content="60" Tag="60" Click="OnFpsChoice" Style="{StaticResource SmallButton}" />
                                <Button Content="90" Tag="90" Click="OnFpsChoice" Style="{StaticResource SmallButton}" />
                                <Button x:Name="Fps120Button" Content="120" Tag="120" Click="OnFpsChoice" Style="{StaticResource SmallButton}" />
                                <Button Content="144" Tag="144" Click="OnFpsChoice" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                            <TextBlock x:Name="GoalThreshold" Text="{Binding GoalLabel}" Style="{StaticResource HintText}" Margin="0,2,0,12" />
                            <WrapPanel IsEnabled="{Binding IsGoalEditable}">
                                <RadioButton x:Name="QualityChoice" Content="画质优先" GroupName="Preference" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumChoice}, ConverterParameter=Quality}" />
                                <RadioButton Content="平衡" GroupName="Preference" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumChoice}, ConverterParameter=Balanced}" />
                                <RadioButton Content="帧率优先" GroupName="Preference" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumChoice}, ConverterParameter=FrameRate}" />
                            </WrapPanel>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,16" />
                            <TextBlock Text="本次录制的实际画质" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <RadioButton Content="低" GroupName="Tier" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding CurrentTier, Converter={StaticResource EnumChoice}, ConverterParameter=Low}" />
                                <RadioButton x:Name="MediumTierChoice" Content="中" GroupName="Tier" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding CurrentTier, Converter={StaticResource EnumChoice}, ConverterParameter=Medium}" />
                                <RadioButton x:Name="HighTierChoice" Content="高" GroupName="Tier" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding CurrentTier, Converter={StaticResource EnumChoice}, ConverterParameter=High}" />
                                <RadioButton Content="极高" GroupName="Tier" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding CurrentTier, Converter={StaticResource EnumChoice}, ConverterParameter=Ultra}" />
                                <RadioButton Content="自定义 / 未知" GroupName="Tier" Style="{StaticResource ChoiceButton}"
                                             IsChecked="{Binding CurrentTier, Converter={StaticResource EnumChoice}, ConverterParameter=Unknown}" />
                            </WrapPanel>
                            <TextBlock Text="分辨率 / 渲染比例" Style="{StaticResource MetricLabel}" Margin="0,9,0,7" />
                            <TextBox x:Name="ResolutionInput" Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" MaxLength="90"
                                     ToolTip="例如 2560 × 1440，DLSS 质量" />
                            <TextBlock Text="逐项画面设置" Style="{StaticResource MetricLabel}" Margin="0,14,0,7" />
                            <TextBox x:Name="GraphicsInput" Text="{Binding GraphicsSettings, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="104" VerticalScrollBarVisibility="Auto"
                                     ToolTip="写下实际设置，例如：纹理高、体积雾中、阴影中、光追关闭。不会自动读取或改游戏配置。" />
                            <TextBlock Text="录制场景 / 备注" Style="{StaticResource MetricLabel}" Margin="0,14,0,7" />
                            <TextBox Text="{Binding Scene, UpdateSourceTrigger=PropertyChanged}" MaxLength="220" />
                            <TextBlock Text="硬件信息 · 分享卡使用" Style="{StaticResource MetricLabel}" Margin="0,18,0,7" />
                            <TextBlock Text="由你填写，不猜硬件；留空显示“未填写”。" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                            <TextBlock Text="显卡" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                            <TextBox x:Name="GpuInput" Text="{Binding Gpu, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                            <TextBlock Text="处理器" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding Cpu, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                            <TextBlock Text="内存 / 显存" Style="{StaticResource HintText}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding Memory, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                            <TextBlock Text="每次导入会保存当时填写的配置，便于比较。新日志导入前，请先更新本次实际设置。"
                                       Style="{StaticResource HintText}" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel>
                            <Button x:Name="NewGoalButton" Content="＋  新建目标 / 开始新对比" Click="OnNewGoal" Style="{StaticResource GhostButton}" IsEnabled="{Binding IsBusy, Converter={StaticResource EnumChoice}, ConverterParameter=False}" />
                            <Button x:Name="LoadPlanButton" Content="载入已保存方案" Click="OnLoadPlan" Style="{StaticResource GhostButton}" Margin="0,7,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource EnumChoice}, ConverterParameter=False}" />
                            <TextBlock Text="不启动游戏 · 不修改设置 · 不上传日志" Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MEASURE / COMPARE / KEEP" Style="{StaticResource EyebrowText}" />
                        <TextBlock x:Name="GameHeading" Text="{Binding Game}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,12,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ShareButton" Content="↗  分享配置卡" Click="OnShowShare" Style="{StaticResource GhostButton}" IsEnabled="{Binding HasRounds}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="OverviewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShareVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="导入本次日志" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SessionLabel}" Foreground="{StaticResource LimeBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Text="支持 NVIDIA 性能 CSV、逐帧耗时 CSV。无需在 NVIDIA 优化名单中；按日志格式识别，不按游戏名限制。"
                                           Style="{StaticResource HintText}" Margin="0,7,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="LogPathInput" Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="性能日志文件"
                                             IsEnabled="{Binding CanImport}" ToolTip="选择完整游玩片段；多个游戏 PID 或时间倒退的日志会被拒绝。" />
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="选择文件" Click="OnBrowseLog" Style="{StaticResource GhostButton}" IsEnabled="{Binding CanImport}" Margin="8,0,0,0" />
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="AnalyzeButton" Content="{Binding ImportLabel}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                    <Button x:Name="LatestLogButton" Content="读取目录最新日志" Command="{Binding LatestLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                    <Button x:Name="SaveButton" Content="保存当前方案" Command="{Binding SaveCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Expander Header="日志目录（可选）" Margin="0,4,0,0" FontSize="11">
                                    <TextBox x:Name="LogDirectoryInput" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                </Expander>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="12" Margin="0,12,0,0">
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource LimeBrush}" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="0,0,0,4">
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel><TextBlock Text="平均帧率" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="AverageMetric" Text="{Binding AverageFps}" Style="{StaticResource MetricValue}" /><TextBlock Text="FPS / 当前查看轮次" Style="{StaticResource EyebrowText}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel><TextBlock Text="1% Low" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="LowMetric" Text="{Binding LowFps}" Style="{StaticResource MetricValue}" Foreground="{StaticResource LimeBrush}" /><TextBlock Text="摘要值请查看口径" Style="{StaticResource EyebrowText}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel><TextBlock Text="较上次平均变化" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DeltaFps}" FontSize="19" FontFamily="{StaticResource DisplayFont}" Margin="0,14,0,12" /><TextBlock Text="相同数据口径才比较" Style="{StaticResource EyebrowText}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="较上次低帧变化" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding LowDelta}" FontSize="19" FontFamily="{StaticResource DisplayFont}" Margin="0,14,0,12" /><TextBlock Text="场景需相近" Style="{StaticResource EyebrowText}" /></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border x:Name="EmptyRounds" Style="{StaticResource PanelBorder}" Padding="24,30"
                                Visibility="{Binding HasNoRounds, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="从第一份日志开始。" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="先看基线，再手动调画质，再看下一份日志。&#10;不规定几轮；达到你的目标，就保存这一档。"
                                           Style="{StaticResource HintText}" FontSize="12" TextAlignment="Center" Margin="0,10,0,22" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <TextBlock Text="01  记录日志" Foreground="{StaticResource LimeBrush}" Margin="0,0,24,0" />
                                    <TextBlock Text="02  手动调画质" Foreground="{StaticResource LimeBrush}" Margin="0,0,24,0" />
                                    <TextBlock Text="03  比较与保存" Foreground="{StaticResource LimeBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasRounds, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="每次变化，一眼对比" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="点击任意轮次，查看当时的画质、数据与调整建议。" Style="{StaticResource HintText}" Margin="0,6,0,12" />
                                    <ItemsControl x:Name="RoundList" ItemsSource="{Binding Rounds}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnRoundChoice" Style="{StaticResource GhostButton}" Padding="14,11" Margin="0,0,8,8" MinWidth="128">
                                                    <StackPanel HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding RoundLabel}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Average, StringFormat={}{0} FPS}" Foreground="{StaticResource LimeBrush}" FontSize="17" FontFamily="{StaticResource DisplayFont}" Margin="0,5,0,3" />
                                                        <TextBlock Text="{Binding Tier}" Style="{StaticResource HintText}" />
                                                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding Accent}" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SelectedRound.BaselineDelta}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedRound.RoundLabel, StringFormat={}{0} · 手动调整建议}" Style="{StaticResource EyebrowText}" />
                                    <TextBlock x:Name="RecommendationTitle" Text="{Binding SelectedRound.RecommendationTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8" />
                                    <TextBlock Text="{Binding SelectedRound.RecommendationReason}" Style="{StaticResource HintText}" FontSize="12" Margin="0,0,0,14" />
                                    <ItemsControl ItemsSource="{Binding SelectedRound.Suggestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource InkBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Setting}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SuggestedValue}" Foreground="{StaticResource LimeBrush}" TextWrapping="Wrap" Margin="0,5,0,5" />
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource HintText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="你的实际画面设置" FontWeight="SemiBold" Margin="0,10,0,6" />
                                    <TextBlock Text="{Binding SelectedRound.Settings}" Style="{StaticResource HintText}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="将本轮信息填回左侧" Click="OnFillSelected" Style="{StaticResource SmallButton}" />
                                        <Button x:Name="UpdateDetailsButton" Content="用左侧信息更新本轮说明" Command="{Binding UpdateDetailsCommand}" Style="{StaticResource SmallButton}" />
                                    </WrapPanel>
                                    <TextBlock Text="更新说明只修正你填写的记录，不会应用游戏设置。" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="数据口径与注意事项" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedRound.Precision}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SelectedRound.GpuLoad, StringFormat=GPU 平均利用率：{0}}" Style="{StaticResource HintText}" Margin="0,0,18,0" />
                                        <TextBlock Text="{Binding SelectedRound.CpuLoad, StringFormat=CPU 平均利用率：{0}}" Style="{StaticResource HintText}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SelectedRound.SourceName}" Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding SelectedRound.Warnings}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ShareScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsShareVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <WrapPanel x:Name="ShareActions" Margin="0,0,0,14">
                            <Button Content="←  返回对比" Click="OnHideShare" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button x:Name="ExportButton" Content="↓  保存 PNG 图片" Click="OnExportShare" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasRounds}" Margin="0,0,8,8" />
                            <Button Content="保存方案到本机" Command="{Binding SaveCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="分享卡展示选中轮次的实测和实际设置，不是下一轮的建议值。缺失信息可在左侧补充，再更新本轮说明。"
                                   Style="{StaticResource HintText}" Margin="0,0,0,12" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                            <local:ShareCard x:Name="SharePreview" Width="880" />
                        </Viewbox>
                        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource HintText}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
