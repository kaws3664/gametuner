<Window x:Class="GameTuner.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择游戏进程" Width="680" Height="590" MinWidth="520" MinHeight="400"
        Style="{StaticResource {x:Type Window}}"
        Icon="/GameTuner.App;component/Assets/GameTuner.ico" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="选择采集对象" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,20"
                       Text="只读取所选进程的性能，不会启动、关闭或注入游戏。带窗口标题的进程排在前面。"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索进程名、PID 或窗口标题" ToolTip="搜索进程名、PID 或窗口标题"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Margin="10,0,0,0"
                    Style="{StaticResource GhostButton}" Click="Refresh_Click"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="8">
            <ListBox x:Name="ProcessList" ItemsSource="{Binding Processes}"
                     SelectedItem="{Binding SelectedProcess}" MouseDoubleClick="ProcessList_MouseDoubleClick"
                     AutomationProperties.Name="运行进程">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding WindowTitle, TargetNullValue=窗口标题不可用, FallbackValue=窗口标题不可用}"
                                       Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Id, StringFormat=PID {0}}" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" Content="取消  Esc" Style="{StaticResource GhostButton}" IsCancel="True" DockPanel.Dock="Right"/>
            <Button x:Name="SelectButton" Content="选择此进程  Enter" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Select_Click" DockPanel.Dock="Right" Margin="0,0,10,0"
                    IsEnabled="{Binding SelectedProcess, Converter={StaticResource ObjectToBooleanConverter}}"/>
        </DockPanel>
    </Grid>
</Window>
