<UserControl x:Class="GameTuner.App.ShareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="880" FontFamily="{StaticResource BodyFont}" Foreground="#243B34">
    <UserControl.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64756D" />
        </Style>
        <Style x:Key="CardDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="28" />
        </Style>
    </UserControl.Resources>
    <Border Background="#F7F5ED" CornerRadius="20" Padding="36">
        <StackPanel>
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="FRAMESMITH / PLAYER NOTES" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#477363" />
                <TextBlock Grid.Column="1" Text="{Binding ShareDate}" Style="{StaticResource CardLabel}" />
            </Grid>
            <Border Background="#173F35" CornerRadius="16" Padding="32,30" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ShareTitleText" Text="{Binding ShareTitle}" Foreground="#EAF1DE" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Game}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="25" TextWrapping="Wrap" Margin="0,12,24,16" />
                        <TextBlock Text="{Binding GoalLabel}" Foreground="#C5D8CA" FontSize="14" TextWrapping="Wrap" MaxWidth="610" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="106" Height="106" CornerRadius="53" Background="#D8EEA1" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShareVerdict}" Foreground="#173F35" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="MY SETUP" Foreground="#527042" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Margin="0,24,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AVERAGE FPS" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="ShareAverageText" Text="{Binding AverageFps}" FontFamily="{StaticResource DisplayFont}" FontSize="56" FontWeight="SemiBold" Margin="0,7,0,4" />
                    <TextBlock Text="本次实测均值" Foreground="#64756D" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="1% LOW" Style="{StaticResource CardLabel}" />
                    <TextBlock Text="{Binding LowFps}" FontFamily="{StaticResource DisplayFont}" FontSize="56" FontWeight="SemiBold" Foreground="#137568" Margin="0,7,0,4" />
                    <TextBlock Text="低帧口径见底部说明" Foreground="#64756D" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="2" Background="#ECE8D9" CornerRadius="12" Padding="20" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="QUALITY / 档位" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding ShareTier}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6" />
                        <TextBlock Text="{Binding ShareRound}" Foreground="#64756D" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Height="1" Background="#D7DCD0" Margin="0,0,0,24" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="01 / THE MACHINE" Style="{StaticResource CardLabel}" Margin="0,0,0,16" />
                    <TextBlock Text="显卡" FontSize="12" Foreground="#64756D" />
                    <TextBlock x:Name="ShareGpuText" Text="{Binding ShareGpu}" Style="{StaticResource CardDetail}" Margin="0,4,0,14" />
                    <TextBlock Text="处理器" FontSize="12" Foreground="#64756D" />
                    <TextBlock Text="{Binding ShareCpu}" Style="{StaticResource CardDetail}" Margin="0,4,0,14" />
                    <TextBlock Text="内存 / 显存" FontSize="12" Foreground="#64756D" />
                    <TextBlock Text="{Binding ShareMemory}" Style="{StaticResource CardDetail}" Margin="0,4,0,14" />
                    <TextBlock Text="分辨率 / 渲染比例" FontSize="12" Foreground="#64756D" />
                    <TextBlock Text="{Binding ShareResolution}" Style="{StaticResource CardDetail}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="02 / GRAPHICS SETTINGS" Style="{StaticResource CardLabel}" Margin="0,0,0,14" />
                        <TextBlock x:Name="ShareSettingsText" Text="{Binding ShareSettings}" Style="{StaticResource CardDetail}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="#E4ECDD" CornerRadius="10" Padding="18,14" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="本次采集" FontSize="12" Foreground="#477363" />
                    <TextBlock Text="{Binding ShareScene}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,6" />
                    <TextBlock Text="{Binding SharePrecision}" FontSize="12" Foreground="#64756D" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShareDuration}" FontSize="12" Foreground="#64756D" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="硬件与画面设置由玩家填写。日志仅代表该次录制片段；不同电脑、场景、游戏版本或驱动下的表现可能不同。"
                       Foreground="#64756D" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,18,0,0" />
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="MY GAME. MY BALANCE." Foreground="#173F35" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="本地生成 · 无云端上传" Style="{StaticResource CardLabel}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
